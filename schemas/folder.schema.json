{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-wrangler.local/schemas/folder.schema.json",
  "title": "API Wrangler v1 folder",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "collectionId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "collectionId": {
      "type": "string",
      "format": "uuid"
    },
    "parentFolderId": {
      "type": "string",
      "format": "uuid"
    },
    "requestIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    }
  }
}
