{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-wrangler.local/schemas/request.schema.json",
  "title": "API Wrangler v1 request",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "protocol",
    "method",
    "url"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "collectionId": {
      "type": "string",
      "format": "uuid"
    },
    "folderId": {
      "type": "string",
      "format": "uuid"
    },
    "protocol": {
      "const": "http"
    },
    "method": {
      "type": "string",
      "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "query": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        }
      }
    },
    "body": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "scripts": {
      "type": "object",
      "properties": {
        "before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
