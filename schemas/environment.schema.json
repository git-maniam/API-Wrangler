{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-wrangler.local/schemas/environment.schema.json",
  "title": "API Wrangler v1 environment",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "variables"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "variables": {
      "type": "object"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "reference"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^secret:.+"
          }
        },
        "not": {
          "required": [
            "value"
          ]
        }
      }
    }
  }
}
