{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api-wrangler.local/schemas/dataset.schema.json",
  "title": "API Wrangler v1 dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "csv",
            "json",
            "jsonl",
            "inline"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rowIdColumn": {
      "type": "string",
      "minLength": 1
    }
  }
}
