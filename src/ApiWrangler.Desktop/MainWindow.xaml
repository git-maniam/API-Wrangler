                        <TextBlock DockPanel.Dock="Top" Text="{Binding StreamingStatus}" FontWeight="SemiBold" Margin="0,6,0,2" />
                        <TextBox Text="{Binding StreamingTranscript, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{Binding DataContext.EditorFontFamily, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="{Binding DataContext.EditorFontSize, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Streaming transcript" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Mocks &amp; Webhooks">
                <Grid Margin="12" DataContext="{Binding Mocks}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Left: Control & Rule Definition -->
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Text="Local Mock Server" FontWeight="Bold" FontSize="16" Margin="0,0,0,6" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Host: " VerticalAlignment="Center" />
                            <TextBox Width="90" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mock Host" />
                            <TextBlock Text=" Port: " VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Width="50" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mock Port" />
                            <Button Content="{Binding IsRunning, Converter={x:Null}}" Command="{Binding ToggleServerCommand}" Margin="8,0,0,0" Padding="8,2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="Start Mock" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Content" Value="Stop Mock" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                        <CheckBox DockPanel.Dock="Top" Content="Allow external binding (explicit opt-in)" IsChecked="{Binding AllowExternalBinding}" Margin="0,2,0,8" AutomationProperties.Name="Allow external binding" />
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ServerStatus}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        
                        <Separator DockPanel.Dock="Top" Margin="0,4,0,8" />
                        <TextBlock DockPanel.Dock="Top" Text="Add Mock Rule" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock DockPanel.Dock="Top" Text="Rule Name:" Margin="0,2" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                            <TextBlock Text="Method: " VerticalAlignment="Center" />
                            <TextBox Width="50" Text="{Binding NewRuleMethod, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text=" Status: " VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Width="40" Text="{Binding NewRuleStatus, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text=" Delay ms: " VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Width="40" Text="{Binding NewRuleDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Path Pattern (e.g. /api/users/{id}):" Margin="0,2" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding NewRulePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                            <TextBlock Text="Fault Simulation: " VerticalAlignment="Center" />
                            <ComboBox SelectedValue="{Binding NewRuleFault}" SelectedValuePath="Content" Width="140">
                                <ComboBoxItem Content="None" IsSelected="True" />
                                <ComboBoxItem Content="DelayedResponse" />
                                <ComboBoxItem Content="HttpError" />
                                <ComboBoxItem Content="RateLimit" />
                                <ComboBoxItem Content="MalformedPayload" />
                                <ComboBoxItem Content="ConnectionTermination" />
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Response Body (JSON):" Margin="0,2" />
                        <TextBox DockPanel.Dock="Top" Height="70" Text="{Binding NewRuleBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{Binding DataContext.EditorFontFamily, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="{Binding DataContext.EditorFontSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6" />
                        <Button DockPanel.Dock="Top" Content="Add Rule" Command="{Binding AddRuleCommand}" HorizontalAlignment="Left" Padding="12,2" Margin="0,0,0,8" />

                        <TextBlock DockPanel.Dock="Top" Text="Configured Rules:" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <ListBox ItemsSource="{Binding ConfiguredRules}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding PathPattern}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <!-- Right: Live Request Logs & Webhook Debugger -->
                    <DockPanel Grid.Column="1">
                        <TabControl>
                            <TabItem Header="Mock Request Logs">
                                <DockPanel Margin="8">
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock Text="Request Logs &amp; Diagnostics" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Content="Refresh Logs" Command="{Binding RefreshLogsCommand}" Margin="0,0,6,0" />
                                        <Button Content="Reset State" Command="{Binding ResetStateCommand}" Margin="0,0,6,0" />
                                    </WrapPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding LogsSummary}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding RawLogs, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Mock request logs" />
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Webhook Debugger">
                                <DockPanel Margin="8">
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock Text="Path Prefix: " VerticalAlignment="Center" />
                                        <TextBox Width="140" Text="{Binding WebhookPathPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                        <Button Content="{Binding IsWebhookRunning, Converter={x:Null}}" Command="{Binding ToggleWebhookServiceCommand}" Padding="8,2" Margin="0,0,8,0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="Start Webhook Listener" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWebhookRunning}" Value="True">
                                                            <Setter Property="Content" Value="Stop Listener" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Refresh Events" Command="{Binding RefreshWebhookEventsCommand}" />
                                    </WrapPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding WebhookStatus}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding WebhookCapturedCountText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding RawWebhookEvents, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Captured webhook events" />
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Load testing">
                <Grid Margin="12" DataContext="{Binding LoadTesting}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Left: Configuration & Controls -->
                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock DockPanel.Dock="Top" Text="Local Load Execution" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Top" Text="Target URL:" Margin="0,2" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                        
                        <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                            <TextBlock Text="Method: " VerticalAlignment="Center" />
                            <TextBox Width="50" Text="{Binding Method, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text=" VUs: " VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Width="40" Text="{Binding VirtualUsers, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text=" Duration (s): " VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Width="40" Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                            <TextBlock Text="Model: " VerticalAlignment="Center" />
                            <ComboBox SelectedValue="{Binding LoadModel}" SelectedValuePath="Content" Width="170">
                                <ComboBoxItem Content="ClosedLoopVirtualUsers" IsSelected="True" />
                                <ComboBoxItem Content="OpenLoopArrivalRate" />
                            </ComboBox>
                        </WrapPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                            <TextBlock Text="Max p95 (ms): " VerticalAlignment="Center" />
                            <TextBox Width="45" Text="{Binding MaxP95LatencyMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text=" Max Err (%): " VerticalAlignment="Center" Margin="6,0,0,0" />
                            <TextBox Width="40" Text="{Binding MaxErrorRatePercent, UpdateSourceTrigger=PropertyChanged}" />
                        </WrapPanel>

                        <CheckBox DockPanel.Dock="Top" Content="Explicit target confirmation acknowledged" IsChecked="{Binding Confirmed}" Margin="0,4,0,8" />

                        <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,8">
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Start Test" Command="{Binding StartLoadTestCommand}" Margin="0,0,8,0" Padding="16,6" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelLoadTestCommand}" Padding="14,6" />
                        </WrapPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontWeight="SemiBold" Margin="0,4,0,4" />
                    </DockPanel>
                    <!-- Right: Reports & Histograms -->
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="Load Execution Metrics &amp; Percentiles" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                        <TextBox Text="{Binding ReportSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" AutomationProperties.Name="Load test report summary" />
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Dataset feasibility">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="100,000 synthetic cases · paged rows · read-only feasibility fixture" Margin="0,0,0,12" />
                    <DataGrid x:Name="FixtureGrid" ItemsSource="{Binding Dataset}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Synthetic dataset">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Case ID" Binding="{Binding CaseId}" Width="180" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                            <DataGridTextColumn Header="Expected status" Binding="{Binding ExpectedStatus}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Dataset grid &amp; clipboard">
                <Grid Margin="12" DataContext="{Binding DatasetGrid}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="_Clear" Command="{Binding ClearSearchCommand}" Margin="4,0,0,0" AutomationProperties.Name="Clear filter" />
                        <Button DockPanel.Dock="Right" Content="_Filter" Command="{Binding SearchCommand}" Margin="8,0,0,0" AutomationProperties.Name="Apply filter" />
                        <Label Content="_Search / Filter:" Target="{Binding ElementName=GridSearchBox}" VerticalAlignment="Center" Margin="0,0,8,0" Padding="0" />
                        <TextBox x:Name="GridSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dataset search filter" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="↶ _Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,6,0" AutomationProperties.Name="Undo grid edit" />
                        <Button Content="↷ _Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Margin="0,0,12,0" AutomationProperties.Name="Redo grid edit" />
                        <Button Content="_Paste clipboard" Command="{Binding PasteFromClipboardCommand}" Margin="0,0,6,0" AutomationProperties.Name="Paste from clipboard" AutomationProperties.HelpText="Detects TSV, CSV, or JSON from clipboard. cURL commands are safely previewed without execution." />
                        <Button Content="_Duplicate case" Command="{Binding DuplicateSelectedRowCommand}" Margin="0,0,6,0" AutomationProperties.Name="Duplicate case" />
                        <Button Content="Fill _down" Command="{Binding FillDownCommand}" Margin="0,0,6,0" AutomationProperties.Name="Fill down selected column" />
                        <Button Content="_Insert row" Command="{Binding InsertRowCommand}" Margin="0,0,6,0" AutomationProperties.Name="Insert new row" />
                        <Button Content="De_lete row" Command="{Binding DeleteSelectedRowCommand}" Margin="0,0,12,0" AutomationProperties.Name="Delete selected row" />
                        <CheckBox Content="Spreadsheet-_safe export" IsChecked="{Binding IsSpreadsheetSafe}" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.HelpText="Neutralizes leading formula characters (=, +, -, @) to prevent formula execution in spreadsheet applications." />
                        <Button Content="_Export CSV" Command="{Binding ExportSpreadsheetSafeCommand}" Margin="0,0,12,0" AutomationProperties.Name="Export CSV" />
                        <Button Content="_Attach external results" Command="{Binding AttachExternalResultsCommand}" Margin="0,0,6,0" AutomationProperties.Name="Attach external results" AutomationProperties.HelpText="Attach pasted results from external test runners (e.g. Newman, JUnit). Tagged as non-Wrangler execution." />
                    </WrapPanel>
                    <DataGrid x:Name="EditableGrid" Grid.Row="2" ItemsSource="{Binding Grid}" SelectedIndex="{Binding SelectedRowIndex}"
                        AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True" CanUserSortColumns="True"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True" SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                        AutomationProperties.Name="Editable virtualized dataset grid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Case ID" Binding="{Binding CaseId}" IsReadOnly="False" Width="180" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Cells[email]}" IsReadOnly="False" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Cells[status]}" IsReadOnly="False" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="DarkSlateGray" />
                        <TextBlock Text="{Binding ClipboardSummary}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="DimGray" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Git collaboration">
                <Grid Margin="12" DataContext="{Binding Git}" IsEnabled="{Binding CanInteract}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Git executable" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding GitExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="Executable path or command name" AutomationProperties.Name="Git executable path" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="_Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="_Initialize" Command="{Binding InitializeCommand}" Margin="8,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Text="Repository path" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding RepositoryPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Git repository path" />
                    </DockPanel>
                    <DockPanel Grid.Row="2" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="_Clone" Command="{Binding CloneCommand}" Margin="8,0,0,0" />
                        <TextBlock DockPanel.Dock="Left" Text="Clone / remote URL" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Git clone URL or remote URL" />
                    </DockPanel>
                    <DockPanel Grid.Row="3" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Add remote" Command="{Binding AddRemoteCommand}" Margin="4,0,0,0" />
                            <Button Content="Select" Command="{Binding SelectRemoteCommand}" Margin="4,0,0,0" />
                            <Button Content="Fetch" Command="{Binding FetchCommand}" Margin="4,0,0,0" />
                            <Button Content="Push" Command="{Binding PushCommand}" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Remote name" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding RemoteName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Git remote name" />
                    </DockPanel>
                    <DockPanel Grid.Row="4" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="New branch" Command="{Binding CreateBranchCommand}" Margin="4,0,0,0" />
                            <Button Content="Switch" Command="{Binding SwitchBranchCommand}" Margin="4,0,0,0" />
                            <Button Content="Fast-forward" Command="{Binding FastForwardCommand}" Margin="4,0,0,0" />
                            <Button Content="History" Command="{Binding LoadHistoryCommand}" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Branch" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Branches}" Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" AutomationProperties.Name="Git branch" />
                    </DockPanel>
                    <DockPanel Grid.Row="5" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Label Content="Compare base" Target="{Binding ElementName=GitCompareBaseBox}" VerticalAlignment="Center" Padding="0" Margin="4,0,4,0" />
                            <TextBox x:Name="GitCompareBaseBox" Text="{Binding ComparisonBaseBranch, UpdateSourceTrigger=PropertyChanged}" Width="110" VerticalContentAlignment="Center" AutomationProperties.Name="GitHub comparison base branch" />
                            <Button Content="Compare" Command="{Binding OpenGitHubCompareCommand}" Margin="4,0,0,0" />
                            <Button Content="Merge" Command="{Binding MergeCommand}" Margin="4,0,0,0" />
                            <Button Content="Rebase" Command="{Binding RebaseCommand}" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Revision" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" ToolTip="Revision or branch for merge, rebase, or restore" AutomationProperties.Name="Git integration revision" />
                    </DockPanel>
                    <TabControl x:Name="GitDetailTabs" Grid.Row="6">
                      <TabItem Header="Status &amp; history">
                       <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Working-tree changes" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding Changes}" AutomationProperties.Name="Git working-tree changes" />
                            </DockPanel>
                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="Recent commits" Margin="0,0,0,4" />
                                <ListBox ItemsSource="{Binding History}" AutomationProperties.Name="Git commit history">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Subject}" ToolTip="{Binding Hash}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                        <DockPanel Grid.Row="2" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Restore path" Command="{Binding RestoreCommand}" Margin="8,0,0,0" />
                            <TextBlock DockPanel.Dock="Left" Text="API Wrangler asset path" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding AssetPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Path under api-wrangler/" AutomationProperties.Name="Asset path to restore" />
                        </DockPanel>
                       </Grid>
                      </TabItem>
                      <TabItem Header="Commit review">
                       <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Review selected files" Command="{Binding ReviewSelectedCommitCommand}" Margin="8,0,0,0" />
                            <TextBlock DockPanel.Dock="Left" Text="Repository paths under api-wrangler/, one per line" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding SelectedCommitPaths, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="48" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected API Wrangler commit paths" />
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Commit reviewed files" Command="{Binding CommitReviewedCommand}" IsEnabled="{Binding CanCommitReviewed}" Margin="8,0,0,0" />
                            <TextBlock DockPanel.Dock="Left" Text="Commit message" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reviewed commit message" />
                        </DockPanel>
                        <TextBox Grid.Row="2" Text="{Binding CommitDiff, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Exact cached commit diff" />
                        <TextBlock Grid.Row="3" Text="{Binding CommitReviewStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="4" Text="Review the full diff before committing. Configured Git hooks and signing remain enabled; hooks may run code." TextWrapping="Wrap" Margin="0,4,0,0" />
                       </Grid>
                      </TabItem>
                      <TabItem Header="Conflicts">
                       <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" DataContext="{Binding Conflicts}">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Load versions" Command="{Binding LoadCommand}" Margin="8,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="Find conflicts" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                                <Label DockPanel.Dock="Left" Content="Unresolved path" Target="{Binding ElementName=GitConflictPath}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="GitConflictPath" ItemsSource="{Binding Paths}" SelectedItem="{Binding SelectedPath}" AutomationProperties.Name="Unresolved Git project path" />
                            </DockPanel>
                            <TextBlock Text="Compare Git's base, local (stage 2), and incoming (stage 3). During rebase, these labels follow Git's stage meanings." TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TabControl Height="150" Margin="0,0,0,6">
                                <TabItem Header="Base"><TextBox Text="{Binding BaseText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Conflict base version" /></TabItem>
                                <TabItem Header="Local"><TextBox Text="{Binding LocalText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Conflict local stage 2 version" /></TabItem>
                                <TabItem Header="Incoming"><TextBox Text="{Binding IncomingText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Conflict incoming stage 3 version" /></TabItem>
                            </TabControl>
                            <TextBlock Text="Conflict decisions" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConflictDetails}" TextWrapping="Wrap" Margin="0,4,0,6" />
                            <Label Content="Proposed result / text editor" Target="{Binding ElementName=GitConflictDraft}" Padding="0" Margin="0,0,0,4" />
                            <TextBox x:Name="GitConflictDraft" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Height="180" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Editable conflict result" />
                            <WrapPanel Margin="0,6,0,6">
                                <Button Content="Review edited result" Command="{Binding ReviewEditedCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,4" />
                                <Button Content="Review local version" Command="{Binding UseLocalCommand}" Margin="0,0,8,4" />
                                <Button Content="Review incoming version" Command="{Binding UseIncomingCommand}" Margin="0,0,8,4" />
                                <Button Content="Review deletion" Command="{Binding DeleteCommand}" Margin="0,0,8,4" />
                            </WrapPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Review save both" Command="{Binding SaveBothCommand}" Margin="8,0,0,0" />
                                <Label DockPanel.Dock="Left" Content="Incoming copy path" Target="{Binding ElementName=GitConflictSaveBothPath}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="GitConflictSaveBothPath" Text="{Binding SaveBothPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="New repository-relative path under api-wrangler/. Local stays at the original path." AutomationProperties.Name="Save both incoming version path" />
                            </DockPanel>
                            <TextBlock Text="Final diff" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FinalDiff, Mode=OneWay}" IsReadOnly="True" Height="180" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Final conflict resolution diff" />
                            <CheckBox Content="I resolved the listed conflicts and reviewed this final diff." IsChecked="{Binding ReviewAccepted}" Margin="0,8,0,6" />
                            <Button Content="Mark reviewed path resolved" Command="{Binding ResolveCommand}" IsEnabled="{Binding CanResolve}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="Recovery copies" FontWeight="SemiBold" Margin="0,6,0,4" />
                            <TextBox Text="{Binding RecoveryPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Conflict recovery copies directory" />
                        </StackPanel>
                       </ScrollViewer>
                      </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="7" Margin="0,8,0,0">
                        <TextBlock Text="{Binding OperationStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StatusBar Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" /></StatusBar>
    </Grid>
</Window>
