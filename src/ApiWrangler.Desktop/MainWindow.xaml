<Window x:Class="ApiWrangler.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ApiWrangler.Desktop"
    xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit"
    Title="API Wrangler — Workbench" Width="1180" Height="800" MinWidth="800" MinHeight="600">
    <Window.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" /></Window.InputBindings>
    <Grid Margin="20" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="API Wrangler" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Local HTTP workbench · foundation preview" VerticalAlignment="Center" Margin="24,0,0,0" />
        </DockPanel>
        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="Project assets">
                <Grid Margin="12" DataContext="{Binding ProjectEditor}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="_Open project" Command="{Binding OpenProjectCommand}" Margin="8,0,0,0" />
                        <Label DockPanel.Dock="Left" Content="_Project path" Target="{Binding ElementName=ProjectPathBox}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
                        <TextBox x:Name="ProjectPathBox" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project directory or manifest path" />
                    </DockPanel>
                    <Label Grid.Row="1" Content="Project _asset" Target="{Binding ElementName=ProjectAssetSelector}" Padding="0" Margin="0,0,0,4" />
                    <ComboBox x:Name="ProjectAssetSelector" Grid.Row="2" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="Path" Margin="0,0,0,8" AutomationProperties.Name="Project asset" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Editor draft" Margin="0,0,0,4" />
                            <editor:TextEditor x:Name="ProjectDraftEditor" local:EditorBinding.Text="{Binding EditorText}" IsReadOnly="{Binding IsEditorReadOnly}" ShowLineNumbers="True" FontFamily="Consolas" AutomationProperties.Name="Project asset draft" AutomationProperties.HelpText="Edit the selected JSON asset. Compare with the disk version on the right before choosing a conflict action." />
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Current disk version" Margin="0,0,0,4" />
                            <editor:TextEditor x:Name="ProjectDiskEditor" local:EditorBinding.Text="{Binding DiskText, Mode=OneWay}" IsReadOnly="True" ShowLineNumbers="True" FontFamily="Consolas" AutomationProperties.Name="Project asset disk version" />
                        </DockPanel>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="ProjectStatusText" Text="{Binding ProjectStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="_Save" Command="{Binding SaveAssetCommand}" IsEnabled="{Binding CanEdit}" Margin="8,0,0,0" />
                            <Button Content="Use _disk" Command="{Binding UseDiskCommand}" IsEnabled="{Binding CanUseDisk}" Margin="8,0,0,0" AutomationProperties.HelpText="Discard the local draft and load the disk version." />
                            <Button Content="Use d_raft" Command="{Binding UseDraftCommand}" IsEnabled="{Binding CanUseDraft}" Margin="8,0,0,0" AutomationProperties.HelpText="Keep the local draft; saving it will replace the disk version." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="HTTP workbench">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="6" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Label Content="Env:" Padding="0" VerticalAlignment="Center" Margin="8,0,4,0" />
                            <ComboBox ItemsSource="{Binding ProjectEnvironments}" SelectedItem="{Binding SelectedEnvironment}" DisplayMemberPath="Name" Width="130" Margin="0,0,8,0" AutomationProperties.Name="Selected environment" />
                            <Button Content="_New" Command="{Binding NewRequestCommand}" Margin="4,0" AutomationProperties.Name="New request" />
                            <Button Content="_Save request" Command="{Binding SaveRequestCommand}" Margin="4,0" AutomationProperties.Name="Save request" />
                            <Button Content="_Close" Command="{Binding CloseRequestCommand}" Margin="4,0" AutomationProperties.Name="Close request" />
                            <ComboBox ItemsSource="{Binding ProjectRequests}" SelectedItem="{Binding SelectedProjectRequest}" DisplayMemberPath="Path" Width="160" Margin="8,0,0,0" AutomationProperties.Name="Saved project requests" />
                            <Button Content="_Open" Command="{Binding LoadRequestCommand}" Margin="4,0,0,0" AutomationProperties.Name="Open selected request" />
                        </StackPanel>
                        <Label Content="Request _name:" Target="{Binding ElementName=RequestNameBox}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="RequestNameBox" Text="{Binding RequestName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="Request name" />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Methods}" Text="{Binding Method}" IsEditable="True" VerticalContentAlignment="Center" AutomationProperties.Name="HTTP method" />
                        <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" AutomationProperties.Name="Request URL" />
                        <Button Grid.Column="2" Content="_Send" Command="{Binding SendCommand}" AutomationProperties.AutomationId="SendRequest" />
                        <Button Grid.Column="3" Content="Cancel" Command="{Binding SendCancelCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Redirects are preserved or followed per settings. Response bodies stay on this machine." Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TabControl x:Name="RequestTabs" Grid.Row="3">
                        <TabItem Header="Headers"><TextBox Text="{Binding RequestHeaders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Request headers" AutomationProperties.HelpText="Enter headers as Name: value per line. Repeated header names are supported." /></TabItem>
                        <TabItem Header="Body">
                            <Grid Margin="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <Label Content="Body _mode:" Target="{Binding ElementName=BodyModeCombo}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
                                    <ComboBox x:Name="BodyModeCombo" ItemsSource="{Binding BodyModes}" SelectedItem="{Binding BodyMode}" Width="140" AutomationProperties.Name="Request body mode" />
                                    <Label Content="File _path:" Target="{Binding ElementName=BodyFilePathBox}" VerticalAlignment="Center" Padding="0" Margin="16,0,8,0" />
                                    <TextBox x:Name="BodyFilePathBox" Text="{Binding BodyFilePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="File-backed body path" />
                                </DockPanel>
                                <editor:TextEditor Grid.Row="1" x:Name="RequestBodyEditor" local:EditorBinding.Text="{Binding RequestBody}" ShowLineNumbers="True" FontFamily="Consolas" FontSize="14" AutomationProperties.Name="Request text or JSON body" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Query params"><TextBox Text="{Binding RequestQuery, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Request query parameters" AutomationProperties.HelpText="Enter query parameters as name=value per line. Repeated parameter names are supported." /></TabItem>
                        <TabItem Header="Transport settings">
                            <StackPanel Margin="12">
                                <CheckBox Content="Follow redirects automatically (cross-origin auth is stripped)" IsChecked="{Binding FollowRedirects}" Margin="0,0,0,12" AutomationProperties.Name="Follow redirects" />
                                <CheckBox Content="Dangerous: ignore TLS certificate errors (override default TLS validation)" IsChecked="{Binding DangerousIgnoreTlsErrors}" Margin="0,0,0,4" AutomationProperties.Name="Ignore TLS errors" />
                                <TextBlock Text="Warning: TLS verification is strictly enabled by default. Ignoring errors exposes traffic to interception." Foreground="DarkRed" Margin="24,0,0,0" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Variables">
                            <DockPanel Margin="8">
                                <Button DockPanel.Dock="Top" Content="_Inspect variables" Command="{Binding InspectVariablesCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" AutomationProperties.Name="Inspect active variables" />
                                <TextBox Text="{Binding VariablesInspectionText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Variable inspection results" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Auth">
                            <StackPanel Margin="12">
                                <DockPanel Margin="0,0,0,12">
                                    <Label Content="Auth _type:" Target="{Binding ElementName=AuthTypeCombo}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
                                    <ComboBox x:Name="AuthTypeCombo" ItemsSource="{Binding AuthTypes}" SelectedItem="{Binding AuthType}" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Authentication type" />
                                </DockPanel>
                                <StackPanel Margin="0,4,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Label Content="User / Key:" VerticalAlignment="Center" Padding="0" />
                                        <TextBox Grid.Column="1" Text="{Binding AuthUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Auth user or API key name" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Label Content="Secret / Token:" VerticalAlignment="Center" Padding="0" />
                                        <TextBox Grid.Column="1" Text="{Binding AuthPassword, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Auth password, secret or token" />
                                    </Grid>
                                    <TextBlock Text="Values support variable substitution (e.g. {{secret:myToken}}). Secrets are redacted from previews and logs." Foreground="Gray" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" />
                    <TabControl Grid.Row="5">
                        <TabItem Header="Response body"><editor:TextEditor local:EditorBinding.Text="{Binding ResponseBody, Mode=OneWay}" IsReadOnly="True" ShowLineNumbers="True" FontFamily="Consolas" FontSize="14" AutomationProperties.Name="Response body" /></TabItem>
                        <TabItem Header="Response headers"><TextBox Text="{Binding ResponseHeaders, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Response headers" /></TabItem>
                        <TabItem Header="Cookies"><TextBox Text="{Binding ResponseCookies, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Response cookies" /></TabItem>
                        <TabItem Header="Local artifact"><TextBox Text="{Binding ArtifactPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Local response body path" /></TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="Dataset feasibility">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="100,000 synthetic cases · paged rows · read-only feasibility fixture" Margin="0,0,0,12" />
                    <DataGrid x:Name="FixtureGrid" ItemsSource="{Binding Dataset}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Synthetic dataset">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Case ID" Binding="{Binding CaseId}" Width="180" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                            <DataGridTextColumn Header="Expected status" Binding="{Binding ExpectedStatus}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <StatusBar Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" /></StatusBar>
    </Grid>
</Window>
