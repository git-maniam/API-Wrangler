<Window x:Class="ApiWrangler.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ApiWrangler.Desktop"
    xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit"
    Title="API Wrangler — Workbench" Width="1180" Height="800" MinWidth="800" MinHeight="600">
    <Window.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" /></Window.InputBindings>
    <Grid Margin="20" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="_Font:" Target="{Binding ElementName=FontFamilyCombo}" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0" />
                <ComboBox x:Name="FontFamilyCombo" ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding EditorFontFamily}" Width="130" Margin="0,0,12,0" AutomationProperties.Name="Editor font family" />
                <Label Content="_Size:" Target="{Binding ElementName=FontSizeCombo}" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0" />
                <ComboBox x:Name="FontSizeCombo" ItemsSource="{Binding AvailableFontSizes}" SelectedItem="{Binding EditorFontSize}" Width="65" AutomationProperties.Name="Editor font size" />
            </StackPanel>
            <TextBlock Text="API Wrangler" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Local HTTP workbench · foundation preview" VerticalAlignment="Center" Margin="24,0,0,0" />
        </DockPanel>
        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="Project assets">
                <Grid Margin="12" DataContext="{Binding ProjectEditor}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="_Open project" Command="{Binding OpenProjectCommand}" Margin="8,0,0,0" />
                        <Label DockPanel.Dock="Left" Content="_Project path" Target="{Binding ElementName=ProjectPathBox}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
                        <TextBox x:Name="ProjectPathBox" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Project directory or manifest path" />
                    </DockPanel>
                    <Label Grid.Row="1" Content="Project _asset" Target="{Binding ElementName=ProjectAssetSelector}" Padding="0" Margin="0,0,0,4" />
                    <ComboBox x:Name="ProjectAssetSelector" Grid.Row="2" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="Path" Margin="0,0,0,8" AutomationProperties.Name="Project asset" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Editor draft" Margin="0,0,0,4" />
                            <editor:TextEditor x:Name="ProjectDraftEditor" local:EditorBinding.Text="{Binding EditorText}"
                                local:EditorBinding.SyntaxHighlighting="Json"
                                IsReadOnly="{Binding IsEditorReadOnly}" ShowLineNumbers="True"
                                FontFamily="{Binding DataContext.EditorFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                FontSize="{Binding DataContext.EditorFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Project asset draft"
                                AutomationProperties.HelpText="Edit the selected JSON asset. Compare with the disk version on the right before choosing a conflict action." />
                        </DockPanel>
                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Current disk version" Margin="0,0,0,4" />
                            <editor:TextEditor x:Name="ProjectDiskEditor" local:EditorBinding.Text="{Binding DiskText, Mode=OneWay}"
                                local:EditorBinding.SyntaxHighlighting="Json"
                                IsReadOnly="True" ShowLineNumbers="True"
                                FontFamily="{Binding DataContext.EditorFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                FontSize="{Binding DataContext.EditorFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="Project asset disk version" />
                        </DockPanel>
                    </Grid>
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="ProjectStatusText" Text="{Binding ProjectStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="_Save" Command="{Binding SaveAssetCommand}" IsEnabled="{Binding CanEdit}" Margin="8,0,0,0" />
                            <Button Content="Use _disk" Command="{Binding UseDiskCommand}" IsEnabled="{Binding CanUseDisk}" Margin="8,0,0,0" AutomationProperties.HelpText="Discard the local draft and load the disk version." />
                            <Button Content="Use d_raft" Command="{Binding UseDraftCommand}" IsEnabled="{Binding CanUseDraft}" Margin="8,0,0,0" AutomationProperties.HelpText="Keep the local draft; saving it will replace the disk version." />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="HTTP workbench">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="6" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="_New" Command="{Binding NewRequestCommand}" Margin="4,0,0,0" AutomationProperties.Name="New request" />
                            <Button Content="_Save" Command="{Binding SaveRequestCommand}" Margin="4,0,0,0" AutomationProperties.Name="Save request" />
                            <Button Content="_Close" Command="{Binding CloseRequestCommand}" Margin="4,0,0,0" AutomationProperties.Name="Close request" />
                        </StackPanel>
                        <Label Content="Saved _request:" Target="{Binding ElementName=SavedRequestCombo}" VerticalAlignment="Center" Margin="0,0,8,0" Padding="0" />
                        <ComboBox x:Name="SavedRequestCombo" ItemsSource="{Binding ProjectRequests}" SelectedItem="{Binding SelectedProjectRequest}" DisplayMemberPath="Path" AutomationProperties.Name="Saved project request" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <Label Content="_Environment:" Target="{Binding ElementName=EnvironmentCombo}" VerticalAlignment="Center" Margin="0,0,8,0" Padding="0" />
                        <ComboBox x:Name="EnvironmentCombo" ItemsSource="{Binding ProjectEnvironments}" SelectedItem="{Binding SelectedEnvironment}" DisplayMemberPath="Path" Width="200" AutomationProperties.Name="Active environment" />
                        <Label Content="Name:" Target="{Binding ElementName=RequestNameBox}" VerticalAlignment="Center" Margin="16,0,8,0" Padding="0" />
                        <TextBox x:Name="RequestNameBox" Text="{Binding RequestName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Request name" />
                    </DockPanel>
                    <DockPanel Grid.Row="2" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="_Send" Command="{Binding SendCommand}" FontWeight="SemiBold" Padding="20,8" Margin="8,0,0,0" AutomationProperties.Name="Send HTTP request" AutomationProperties.HelpText="Executes the configured request. Press Ctrl+Enter from anywhere in the workbench." />
                        <Button DockPanel.Dock="Right" Content="_Cancel" Command="{Binding CancelSendCommand}" Padding="12,8" Margin="8,0,0,0" AutomationProperties.Name="Cancel sending request" />
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" Width="100" Margin="0,0,8,0" AutomationProperties.Name="HTTP method" />
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Request URL" AutomationProperties.HelpText="Enter an absolute HTTP(S) URL. Credentials are not permitted." />
                    </DockPanel>
                    <TabControl x:Name="RequestTabs" Grid.Row="3">
                        <TabItem Header="Headers"><TextBox Text="{Binding RequestHeaders, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Request headers" AutomationProperties.HelpText="Enter headers as Name: value per line. Repeated header names are supported." /></TabItem>
                        <TabItem Header="Body">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding BodyModes}" SelectedItem="{Binding BodyMode}" Width="120" AutomationProperties.Name="Request body mode" />
                                    <Button DockPanel.Dock="Right" Content="Format _body" Command="{Binding FormatRequestBodyCommand}" Margin="0,0,8,0" AutomationProperties.Name="Format request body" />
                                    <TextBox Text="{Binding BodyFilePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="File upload path" AutomationProperties.HelpText="Required when body mode is file." />
                                </DockPanel>
                                <Border Grid.Row="1" Background="#FFEBEE" Padding="8,4" Margin="0,0,0,4" Visibility="{Binding RequestBodyDiagnosticVisibility}">
                                    <TextBlock Text="{Binding RequestBodyDiagnostic}" Foreground="#C62828" TextWrapping="Wrap" AutomationProperties.Name="Request body diagnostic" />
                                </Border>
                                <editor:TextEditor Grid.Row="2" x:Name="RequestBodyEditor" local:EditorBinding.Text="{Binding RequestBody}"
                                    local:EditorBinding.SyntaxHighlighting="{Binding RequestHighlighting}"
                                    ShowLineNumbers="True" FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" AutomationProperties.Name="Request text or JSON body" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Query params"><TextBox Text="{Binding RequestQuery, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Request query parameters" AutomationProperties.HelpText="Enter query parameters as name=value per line. Repeated parameter names are supported." /></TabItem>
                        <TabItem Header="Transport settings">
                            <StackPanel Margin="12">
                                <CheckBox Content="Follow redirects (cross-origin auth stripped)" IsChecked="{Binding FollowRedirects}" Margin="0,0,0,8" AutomationProperties.Name="Follow redirects" />
                                <CheckBox Content="Ignore TLS certificate errors (insecure override)" IsChecked="{Binding DangerousIgnoreTlsErrors}" AutomationProperties.Name="Ignore TLS errors" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Variables">
                            <DockPanel Margin="12">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="_Inspect variables" Command="{Binding InspectVariablesCommand}" AutomationProperties.Name="Inspect resolved variables" />
                                    <TextBlock Text="Resolved variable preview and origin scope:" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox Text="{Binding VariablesInspectionText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Variable inspection results" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Auth">
                            <StackPanel Margin="12">
                                <DockPanel Margin="0,0,0,12">
                                    <Label Content="Auth _type:" Target="{Binding ElementName=AuthTypeCombo}" VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
                                    <ComboBox x:Name="AuthTypeCombo" ItemsSource="{Binding AuthTypes}" SelectedItem="{Binding AuthType}" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="Authentication type" />
                                </DockPanel>
                                <StackPanel Margin="0,4,0,0">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Label Content="User / Key:" VerticalAlignment="Center" Padding="0" />
                                        <TextBox Grid.Column="1" Text="{Binding AuthUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Auth user or API key name" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Label Content="Secret / Token:" VerticalAlignment="Center" Padding="0" />
                                        <TextBox Grid.Column="1" Text="{Binding AuthPassword, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Auth password, secret or token" />
                                    </Grid>
                                    <TextBlock Text="Values support variable substitution (e.g. {{secret:myToken}}). Secrets are redacted from previews and logs." Foreground="Gray" Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                    <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" />
                    <TabControl Grid.Row="5">
                        <TabItem Header="Response body">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="8,4,8,4">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Label Content="View:" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0" />
                                        <ComboBox ItemsSource="{Binding ResponseViewModes}" SelectedItem="{Binding ResponseViewMode}" Width="90" AutomationProperties.Name="Response view mode" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ResponseHighlighting, StringFormat='Format: {0}'}" VerticalAlignment="Center" Foreground="Gray" />
                                </DockPanel>
                                <Border Grid.Row="1" Background="#FFF3E0" Padding="8,4" Margin="4,0,4,4" Visibility="{Binding ResponseDiagnosticVisibility}">
                                    <TextBlock Text="{Binding ResponseDiagnostic}" Foreground="#E65100" TextWrapping="Wrap" AutomationProperties.Name="Response diagnostic" />
                                </Border>
                                <editor:TextEditor Grid.Row="2" local:EditorBinding.Text="{Binding ResponseBody, Mode=OneWay}"
                                    local:EditorBinding.SyntaxHighlighting="{Binding ResponseHighlighting}"
                                    IsReadOnly="True" ShowLineNumbers="True"
                                    FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" AutomationProperties.Name="Response body" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Response headers"><TextBox Text="{Binding ResponseHeaders, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" AutomationProperties.Name="Response headers" /></TabItem>
                        <TabItem Header="Cookies"><TextBox Text="{Binding ResponseCookies, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="{Binding EditorFontFamily}" FontSize="{Binding EditorFontSize}" AutomationProperties.Name="Response cookies" /></TabItem>
                        <TabItem Header="Local artifact"><TextBox Text="{Binding ArtifactPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Local response body path" /></TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="Import dataset">
                <Grid Margin="12" DataContext="{Binding DatasetImport}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel IsEnabled="{Binding IsIdle}">
                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dataset source file" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,8" IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="Name " VerticalAlignment="Center" /><TextBox Width="180" Text="{Binding DatasetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dataset name" />
                        <TextBlock Text=" Format " VerticalAlignment="Center" /><ComboBox Width="90" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" AutomationProperties.Name="Dataset format" />
                        <TextBlock Text=" Encoding " VerticalAlignment="Center" /><ComboBox Width="140" ItemsSource="{Binding Encodings}" SelectedItem="{Binding EncodingName}" AutomationProperties.Name="Dataset encoding" />
                        <TextBlock Text=" Delimiter " VerticalAlignment="Center" /><TextBox Width="35" Text="{Binding Delimiter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dataset delimiter" />
                        <TextBlock Text=" Culture " VerticalAlignment="Center" /><TextBox Width="85" Text="{Binding CultureName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Conversion culture, blank for invariant" />
                    </WrapPanel>
                    <TextBlock Grid.Row="2" TextWrapping="Wrap" Text="Column mappings (JSON array): [] preserves all columns. Example: [{&quot;Source&quot;:&quot;amount&quot;,&quot;Target&quot;:&quot;price&quot;,&quot;Type&quot;:&quot;Decimal&quot;}]. Types: Preserve, String, Decimal, Boolean, Date. EmptyStringAsNull is opt-in. Nested JSON stays nested." />
                    <TextBox Grid.Row="3" Height="65" Margin="0,6" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding Mappings, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Dataset column mappings" />
                    <WrapPanel Grid.Row="4" Margin="0,6">
                        <CheckBox Content="Add missing case IDs (review before accepting)" IsChecked="{Binding AddCaseIds}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" />
                        <Button Content="Prepare preview" Command="{Binding PrepareCommand}" IsEnabled="{Binding IsIdle}" Margin="12,0" />
                        <Button Content="Accept import" Command="{Binding AcceptCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,12,0" />
                        <Button Content="Cancel preparation" Command="{Binding PrepareCancelCommand}" />
                        <Button Content="Cancel import" Command="{Binding AcceptCancelCommand}" Margin="8,0" />
                    </WrapPanel>
                    <TextBox Grid.Row="5" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Prepared dataset preview" />
                    <TextBlock Grid.Row="6" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </TabItem>
            <TabItem Header="Dataset feasibility">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="100,000 synthetic cases · paged rows · read-only feasibility fixture" Margin="0,0,0,12" />
                    <DataGrid x:Name="FixtureGrid" ItemsSource="{Binding Dataset}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                        EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Synthetic dataset">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Case ID" Binding="{Binding CaseId}" Width="180" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                            <DataGridTextColumn Header="Expected status" Binding="{Binding ExpectedStatus}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
        <StatusBar Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" /></StatusBar>
    </Grid>
</Window>
